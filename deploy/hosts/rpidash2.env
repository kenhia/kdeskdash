# kdeskdash config for rpidash2 — Pi 5, Ken's dev desk.
#
# Installed to /etc/kdeskdash/kdeskdash.env by `just install-service rpidash2`
# (only if absent; hand edits on the device are never overwritten).
# Committed: no secrets here. Redis passwords come from the fleet's per-host
# file /etc/khomelab/secrets.env, which k-homelab renders from the age store;
# KVSCF_TOKEN is still hand-installed in /etc/kdeskdash/secrets.env — see
# deploy/hosts/README.md. deploy/kdeskdash.env.example documents every var.

# Display / touch: the built-in defaults are correct on both boards
# (card1 = vc4 display; the by-id touch path is stable across reboots).

# Control Redis — local, and passwordless. Remote mode control, last-mode
# persistence, GoL injection, screenshot trigger. It reads
# KDESKDASH_CONTROL_REDISCLI_AUTH, NOT bare REDISCLI_AUTH: that name belongs to
# the central rpi53 password now, and AUTH against a passwordless Redis is an
# error, not a shrug.
KDESKDASH_REDIS_HOST=127.0.0.1
KDESKDASH_REDIS_PORT=6379

# Telemetry source for Dev mode — kpidash's host metrics. That Redis requires
# AUTH, and the password is REDISCLI_AUTH from /etc/khomelab/secrets.env — one
# fleet name for one secret, so nothing about it is set here.
KDESKDASH_TELEMETRY_REDIS_HOST=rpi53
KDESKDASH_TELEMETRY_REDIS_PORT=6379

# Fleet Claude Code activity feed — the CENTRAL Redis on rpi53 since sprint 031
# (kdashdata CD-7). The fleet's publishers write there through kdash-pub; this
# board no longer hosts the feed it reads. Same endpoint as telemetry, so the
# same REDISCLI_AUTH serves it — one secret, one name, two independent
# connections. Sprint 037 collapsed the two private variables that held it.
KDESKDASH_CLAUDE_REDIS_HOST=rpi53
KDESKDASH_CLAUDE_REDIS_PORT=6379

# Launcher + Remote ("foreground") modes drive cleo's kvscf, which still lives
# on THIS board's second instance on 6380. These two lines used to be absent,
# inheriting the Claude feed's values — which is exactly why they have to be
# here now (CD-8): with claude repointed to rpi53, an unset kvscf endpoint
# would silently follow it to central and take the pair with it. kvscf stays
# with its workstation pair; only the claude feed relocates.
# Since sprint 035 that instance requires AUTH and listens on loopback + this
# board's LAN address only (deploy/redis-claude.conf + the hand-installed
# /etc/redis/redis-claude-local.conf), so its password comes from the fleet file
# — on THIS host under the key CLAUDE_REDISCLI_AUTH (store entry
# redis-claude-auth-rpidash2), which is named for the INSTANCE and is not the
# claude feed's password. rpidash3's equivalent is KVSCF_REDISCLI_AUTH; they are
# different secrets, so the fleet gives them different names and kdeskdash tries
# both. Without it both modes show an offline feed. It is the same string cleo's
# kvscf holds as KVSCF_REDIS_PASSWORD.
KDESKDASH_KVSCF_REDIS_HOST=127.0.0.1
KDESKDASH_KVSCF_REDIS_PORT=6380

# Mode set: this panel's full complement, stated explicitly. Identical to the
# built-in default, so the line documents the set rather than changing it —
# and adding or reordering a mode here is now a one-line edit + redeploy.
# List order is both the swipe-cycle order and the Menu tile order.
KDESKDASH_MODES=fun:game_of_life,golz,icons,palette;ops:claude,launcher,foreground,clock,dev,calc
