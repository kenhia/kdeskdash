# kdeskdash config for rpidash2 — Pi 5, Ken's dev desk.
#
# Installed to /etc/kdeskdash/kdeskdash.env by `just install-service rpidash2`
# (only if absent; hand edits on the device are never overwritten).
# Committed: no secrets here. KVSCF_TOKEN lives in /etc/kdeskdash/secrets.env —
# see deploy/hosts/README.md. deploy/kdeskdash.env.example documents every var.

# Display / touch: the built-in defaults are correct on both boards
# (card1 = vc4 display; the by-id touch path is stable across reboots).

# Control Redis — local. Remote mode control, last-mode persistence, GoL
# injection, screenshot trigger.
KDESKDASH_REDIS_HOST=127.0.0.1
KDESKDASH_REDIS_PORT=6379

# Telemetry source for Dev mode — kpidash's host metrics. That Redis requires
# AUTH: KDESKDASH_TELEMETRY_REDISCLI_AUTH goes in secrets.env.
KDESKDASH_TELEMETRY_REDIS_HOST=rpi53
KDESKDASH_TELEMETRY_REDIS_PORT=6379

# Fleet Claude Code activity feed — the local instance is the fleet's feed
# (publisher/claude-pub.sh hooks write here; rpidash3 reads it over the LAN).
KDESKDASH_CLAUDE_REDIS_HOST=127.0.0.1
KDESKDASH_CLAUDE_REDIS_PORT=6380

# Remote ("foreground") mode currently rides the Claude feed endpoint above and
# drives cleo's kvscf. A dedicated KDESKDASH_KVSCF_REDIS_* lands with korg 667
# (WI 664); until then this host needs no extra var.

# Mode set: unset means the full built-in set, which is what this panel shows
# today. KDESKDASH_MODES arrives with korg 667 (WI 662/663); the curated line
# for this host will be:
#KDESKDASH_MODES=fun:game_of_life,golz,icons,palette;ops:claude,foreground,clock,dev,calc
