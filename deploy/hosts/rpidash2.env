# kdeskdash config for rpidash2 — Pi 5, Ken's dev desk.
#
# Installed to /etc/kdeskdash/kdeskdash.env by `just install-service rpidash2`
# (only if absent; hand edits on the device are never overwritten).
# Committed: no secrets here — only the NAMES of the fleet keys that hold them.
# Redis passwords and (since k-homelab sprint 069) both desks' pairing tokens
# come from /etc/khomelab/secrets.env, which k-homelab renders per host from the
# age store. The hand-installed /etc/kdeskdash/secrets.env KVSCF_TOKEN is the
# deprecated fallback — see deploy/hosts/README.md.
# deploy/kdeskdash.env.example documents every var.

# Display / touch: the built-in defaults are correct on both boards
# (card1 = vc4 display; the by-id touch path is stable across reboots).

# The board's own legacy Redis — local and passwordless. Since sprint 039 the
# panel reads it EXACTLY ONCE: on a first run with no /var/lib/kdeskdash/state,
# to copy the old kdeskdash:* values (GoLZ scores, calc registers, dev
# assignments, last mode) into that file. Copy, never move. After that nothing
# dials it, and the k-homelab cleanup slice retires the server.
#
# It reads KDESKDASH_CONTROL_REDISCLI_AUTH, NOT bare REDISCLI_AUTH: that name
# belongs to the central rpi53 password, and AUTH against a passwordless Redis
# is an error, not a shrug.
KDESKDASH_REDIS_HOST=127.0.0.1
KDESKDASH_REDIS_PORT=6379

# Commands (mode switch, settings injection, screenshot) come from CENTRAL now:
# kdash:panelmode:rpidash2 and kdash:panelshot:rpidash2 on rpi53. No endpoint
# line is needed — the command feed falls back to the telemetry endpoint set
# below, which is already rpi53, and inherits REDISCLI_AUTH with it because it
# is the same instance. The {host} segment is derived from the hostname and
# lowercased, so KDESKDASH_PANEL_HOST is not set here either.

# Telemetry source for Dev mode — kpidash's host metrics. That Redis requires
# AUTH, and the password is REDISCLI_AUTH from /etc/khomelab/secrets.env — one
# fleet name for one secret, so nothing about it is set here.
KDESKDASH_TELEMETRY_REDIS_HOST=rpi53
KDESKDASH_TELEMETRY_REDIS_PORT=6379

# Fleet Claude Code activity feed — the CENTRAL Redis on rpi53 since sprint 031
# (kdashdata CD-7). The fleet's publishers write there through kdash-pub; this
# board no longer hosts the feed it reads. Same endpoint as telemetry, so the
# same REDISCLI_AUTH serves it — one secret, one name, two independent
# connections. Sprint 037 collapsed the two private variables that held it.
KDESKDASH_CLAUDE_REDIS_HOST=rpi53
KDESKDASH_CLAUDE_REDIS_PORT=6379

# Launcher + Remote ("foreground") modes drive cleo's deck (kctrldeck since
# 2026-09-19; the kvscf: key namespace is the contract's and stays). Since
# sprint 040 that channel is on CENTRAL — the same rpi53:6379 the claude and
# telemetry handles use — not on this board's own 6380 instance.
#
# The fold is what the endpoint lines say; the three lines under them are what
# make it work, and none of them is optional:
#
#  * AUTH_KEY. This board has BOTH published key names in its environment —
#    CLAUDE_REDISCLI_AUTH (redis-claude's own :6380 password, still rendered
#    because that server runs until the k-homelab cleanup slice) and
#    REDISCLI_AUTH (central's). They are different secrets. Without naming one,
#    kdeskdash's legacy ordered lookup picks CLAUDE_REDISCLI_AUTH and sends the
#    :6380 password to central; AUTH with the wrong password is an ERROR, not a
#    shrug, so the handle never opens and the panel reports "kvscf feed
#    unavailable" as though central were down. Sprint 031's failure, one layer
#    over.
#
#  * PAIR_HOST. Until the fold the endpoint itself scoped this panel to one
#    workstation, because only cleo wrote to this board's 6380. On central the
#    host segment is the only scoping left (kdashdata CD-8), so the pair is
#    stated rather than discovered — this panel reads kvscf:*:cleo and will
#    publish a command to no other host.
#
#  * TOKEN_KEY. The pairing token moved into the fleet file in k-homelab sprint
#    069, under a name per PAIR (the two desks hold different values, and
#    bin/check-secrets refuses one key name meaning two store entries). Same
#    secret as the hand-installed /etc/kdeskdash/secrets.env KVSCF_TOKEN it
#    replaces — verified byte-identical on this board — just a managed home.
#    Delete that file here once this read is proven.
KDESKDASH_KVSCF_REDIS_HOST=rpi53
KDESKDASH_KVSCF_REDIS_PORT=6379
KDESKDASH_KVSCF_REDIS_AUTH_KEY=REDISCLI_AUTH
KDESKDASH_KVSCF_PAIR_HOST=cleo
KDESKDASH_KVSCF_TOKEN_KEY=KCTRLDECK_TOKEN_CLEO_PAIR

# Mode set: this panel's full complement, stated explicitly. Identical to the
# built-in default, so the line documents the set rather than changing it —
# and adding or reordering a mode here is now a one-line edit + redeploy.
# List order is both the swipe-cycle order and the Menu tile order.
KDESKDASH_MODES=fun:game_of_life,golz,icons,palette;ops:claude,launcher,foreground,clock,dev,calc
