# kdeskdash config for rpidash3 — Pi 4 Model B 8GB, Ken's work desk.
#
# Installed to /etc/kdeskdash/kdeskdash.env by `just install-service rpidash3`
# (only if absent; hand edits on the device are never overwritten).
# Committed: no secrets here. Redis passwords come from the fleet's per-host
# file /etc/khomelab/secrets.env, which k-homelab renders from the age store;
# KVSCF_TOKEN is still hand-installed in /etc/kdeskdash/secrets.env — see
# deploy/hosts/README.md. deploy/kdeskdash.env.example documents every var.
#
# Hardware note: despite the Pi 4/Pi 5 split, no display or touch override is
# needed. This board also enumerates the vc4 display on card1 (card0 is the
# render-only v3d node), negotiates the panel's native 1920x440 from EDID with
# no firmware coaxing, and the code's default by-id touch path resolves to the
# ILITEK controller. The binary is generic aarch64 — the same build as rpidash2.

# The board's own legacy Redis — local and passwordless. Since sprint 039 the
# panel reads it EXACTLY ONCE: on a first run with no /var/lib/kdeskdash/state,
# to copy the old kdeskdash:* values (GoLZ scores, calc registers, dev
# assignments, last mode) into that file. Copy, never move. After that nothing
# dials it, and the k-homelab cleanup slice retires the server.
#
# It reads KDESKDASH_CONTROL_REDISCLI_AUTH, NOT bare REDISCLI_AUTH: that name
# belongs to the central rpi53 password, and AUTH against a passwordless Redis
# is an error, not a shrug.
KDESKDASH_REDIS_HOST=127.0.0.1
KDESKDASH_REDIS_PORT=6379

# Commands (mode switch, settings injection, screenshot) come from CENTRAL now:
# kdash:panelmode:rpidash3 and kdash:panelshot:rpidash3 on rpi53. No endpoint
# line is needed — the command feed falls back to the telemetry endpoint set
# below, which is already rpi53, and inherits REDISCLI_AUTH with it because it
# is the same instance. The {host} segment is derived from the hostname and
# lowercased, so KDESKDASH_PANEL_HOST is not set here either.

# Telemetry source for Dev mode — same kpidash feed as rpidash2. That Redis
# requires AUTH, and the password is REDISCLI_AUTH from /etc/khomelab/secrets.env
# — one fleet name for one secret. Without it Dev mode activates but shows no
# host data.
KDESKDASH_TELEMETRY_REDIS_HOST=rpi53
KDESKDASH_TELEMETRY_REDIS_PORT=6379

# Fleet Claude Code activity feed — the CENTRAL Redis on rpi53 since sprint 031
# (kdashdata CD-7); it used to be read over the LAN from rpidash2. Read-only; a
# down endpoint never blocks boot. Same endpoint as telemetry, so the same
# REDISCLI_AUTH serves it — one secret, one name, two independent connections.
# Sprint 037 collapsed the two private variables that held it.
KDESKDASH_CLAUDE_REDIS_HOST=rpi53
KDESKDASH_CLAUDE_REDIS_PORT=6379

# Launcher + Remote ("foreground") modes drive the *work-side* kvscf on kwork,
# not cleo's — so they get their own endpoint rather than reusing the Claude
# feed's. This board pinned them in sprint 026, which is why CD-8's repoint was
# a one-device edit: rpidash2 was the board still inheriting. kwork publishes
# to the second Redis instance on this board (deploy/redis-kvscf.conf, port
# 6380); this panel reads it over loopback.
# That instance requires AUTH, and its password comes from the fleet file as
# KVSCF_REDISCLI_AUTH (store entry redis-kvscf-auth-rpidash3). rpidash2's own
# instance is a different service with a different password and so a different
# key name, CLAUDE_REDISCLI_AUTH; kdeskdash tries both, this one first.
# Without it both modes show an offline feed. The control Redis on 6379 above is
# a different instance and stays loopback-only and passwordless.
KDESKDASH_KVSCF_REDIS_HOST=127.0.0.1
KDESKDASH_KVSCF_REDIS_PORT=6380

# Mode set for the work desk: no simulations, no fleet agent view — the panel
# earns its space with control-plane and utility modes. GoL/GoLZ are omitted by
# preference, not capability (sprint 018 measured the A72 worst case at 75% of
# one core). Launcher leads the ops list: it is this panel's reason to exist
# now that it replaces the Stream Deck, so it is the first tile and the first
# swipe target. List order is both the swipe-cycle order and the Menu tile order.
KDESKDASH_MODES=fun:icons,palette;ops:launcher,foreground,clock,dev,calc
