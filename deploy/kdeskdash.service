# systemd unit for the kdeskdash dashboard appliance.
#
# Normally installed by `just install-service <host>`; by hand it is:
#   sudo install -D -m644 deploy/kdeskdash.service /etc/systemd/system/kdeskdash.service
#   sudo install -D -m600 deploy/hosts/<host>.env /etc/kdeskdash/kdeskdash.env
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kdeskdash
#
# Redis passwords come from /etc/khomelab/secrets.env, which k-homelab renders
# on every host from the age store — this repo neither writes nor holds them.
# KVSCF_TOKEN is still hand-installed in /etc/kdeskdash/secrets.env; see
# deploy/hosts/README.md.
#
# The binary is deployed to /usr/local/bin/kdeskdash by `just deploy <host>`.
[Unit]
Description=kdeskdash touch dashboard
# Redis is optional; start after it when present so remote control/persistence
# are available immediately, but do not fail if it is absent.
After=redis-server.service
Wants=redis-server.service
# Never permanently give up restarting the appliance. With systemd's default
# start limit (StartLimitBurst=5 / StartLimitIntervalSec=10s) a transient
# early-boot crash loop would wedge the unit in `failed` until someone SSHes in
# — unacceptable for a headless boot-to-dashboard panel. 0 disables the limit.
# (This key lives in [Unit] on systemd >= 229, which covers Trixie.)
StartLimitIntervalSec=0

[Service]
# DRM master + evdev access require root on this panel.
User=root
ExecStart=/usr/local/bin/kdeskdash
# Leading '-' makes the env file optional: every KDESKDASH_* var has a built-in
# default, so a missing file must not block the appliance from starting.
#
# Three files, in precedence order — later entries win, so a device-local value
# can always override the fleet one:
#
#   1. the fleet's per-host secrets file, rendered by k-homelab from the age
#      store (root:khomelab 0640). Holds REDISCLI_AUTH (the central rpi53
#      password, serving telemetry, the claude feed and the service card) and
#      KVSCF_REDISCLI_AUTH (this board's own 6380 instance). Not ours to write.
#   2. this device's committed config (deploy/hosts/<host>.env, installed by
#      install-service) — endpoints and the mode set, no secrets.
#   3. KVSCF_TOKEN, hand-installed, mode 0600. The one credential still without
#      a store entry, because who issues it is an open question (korg WI 2479).
#
# No SupplementaryGroups=khomelab, and that is deliberate twice over: this unit
# runs as root, and systemd reads EnvironmentFile= as PID 1 before dropping
# privileges anyway — so the group buys nothing, while naming a group that does
# not exist yet makes the unit FAIL TO START, turning the optional read below
# into a hard dependency on k-homelab having converged. Measured on kstudio,
# systemd 259 (korg handoff 2493).
EnvironmentFile=-/etc/khomelab/secrets.env
EnvironmentFile=-/etc/kdeskdash/kdeskdash.env
EnvironmentFile=-/etc/kdeskdash/secrets.env
Restart=always
RestartSec=2

# --- Sandboxing -----------------------------------------------------------
# Shrink the blast radius of a root process while preserving the two devices the
# panel must reach: the DRM node (/dev/dri/*) and the touch evdev
# (/dev/input/*). We deliberately do NOT set PrivateDevices= / DevicePolicy=,
# which would hide those nodes; the filesystem hardening below leaves /dev
# untouched, so DRM master and touch keep working.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
# Only writable state: the icons-mode favourites file. StateDirectory creates
# /var/lib/kdeskdash and makes just that path writable under ProtectSystem=strict
# (matching KDESKDASH_ICONS_FAVORITES's default). Screenshots land in
# PrivateTmp's /tmp; the env file and runtime font are read-only.
StateDirectory=kdeskdash

[Install]
WantedBy=multi-user.target
